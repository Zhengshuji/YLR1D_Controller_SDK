<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_driver</name>
  <version>0.0.1</version>
  <description>真机驱动层：平替 ylr1d_translate 及以下（translate/control/algorithm/plant），复用 ylr1d_translate action 类型，直调 RobotConSys SDK（底座/臂关节/夹爪）</description>
  <maintainer email="2607430020@qq.com">zsj</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>robot_interfaces</depend>
  <depend>ylr1d_translate</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>